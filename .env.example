# Supabase — create a project at https://supabase.com/dashboard, then copy
# Project Settings -> API Keys. Never commit the populated .env.local file.

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Secret key (shown as "secret", formerly "service_role"), starts with sb_secret_.
# Server-side only: every write in this app runs in a server action or route
# handler. Do NOT prefix this with NEXT_PUBLIC_.
#
# The publishable/anon key will NOT work: RLS is enabled on every table with no
# permissive policies, so a publishable key cannot read or write any row.
#
# SUPABASE_SERVICE_ROLE_KEY is also accepted for older projects.
SUPABASE_SECRET_KEY=
