# Supabase — create a project at https://supabase.com/dashboard, then copy
# Project Settings -> API. Never commit the populated .env.local file.

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Service role key. Server-side only: every write in this app runs in a server
# action or route handler. Do NOT prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
